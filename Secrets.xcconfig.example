// Copy this file to Secrets.xcconfig and fill in the values.
// Secrets.xcconfig is gitignored — never commit real values.
//
// In Xcode: Project > Info > Configurations, set each scheme to use Secrets.xcconfig.

// box-fraise-platform base URL (the iOS client talks to box-fraise; there is
// no separate Whisked-only backend).
WHISKED_API_BASE_URL = https://your-railway-url.up.railway.app
WHISKED_HMAC_KEY = your-hmac-shared-key
WHISKED_BUSINESS_ID = 1
